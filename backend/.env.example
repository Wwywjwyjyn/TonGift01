# نمونه فایل محیطی — کپی کن به .env و مقادیر خودت را بگذار

# ---------- Marketapp API (بخش اجاره/کالکشن/استارز-پریمیوم Fragment) ----------
# توکن از: https://marketapp.org/api-token
MARKETAPP_API_TOKEN=YOUR_TOKEN_HERE

# ---------- تلگرام MTProto (مارکت رسمی گیفت‌های استارزی) ----------
# نیازی به ست کردن نیست — از گیت API داخل اپ (owner.json) خوانده می‌شود.
# اگر بخواهی می‌توانی مستقیم اینجا هم ست کنی (اولویت با این مقادیر است):
# TELEGRAM_API_ID=1234567
# TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# کلید رمزنگاری فایل نشست‌های تلگرام (tg_sessions.json) — یک رشته تصادفی دلخواه
# اگر ست نشود نشست‌ها بدون رمز ذخیره می‌شوند (برای تست) — حتماً در پروداکشن ست کن
TG_SESSION_KEY=change-me-to-a-random-string

# اضطراری: اگر مالک قفل شد (ری‌نستال اپ)، توکن دستگاه جدید را اینجا ست کن تا مالکیت منتقل شود
# OWNER_DEVICE_TOKEN=

# اجازه استفاده از مارکت تلگرام برای همه دستگاه‌ها (پیش‌فرض: فقط دستگاه مالک)
# TG_OPEN_FOR_ALL=1

APP_NAME=بازار گیفت تلگرام
PORT=8080
